{
  "output_dir": "outputs/feature_optimization",
  "diagnostics_dir": "outputs/validation_diagnostics",
  "cache_dir": ".cache/feature_optimization",
  "selection_file": "config/optimization_selection.json",
  "small_results_dir": "res/feature_optimization",
  "export_dir": "outputs/optimization_reproducibility",
  "seed": 42,
  "image_size": 384,
  "orb_nfeatures": 1000,
  "crop": "center",
  "ratios": [0.85, 0.90],
  "ransac_threshold_px": 4.5,
  "ransac_max_iters": 2000,
  "ransac_confidence": 0.99,
  "workers": 4,
  "hue_bins": 16,
  "saturation_bins": 8,
  "depth_bins": 16,
  "clahe_clip_limit": 2.0,
  "clahe_grid": [8, 8],
  "foreground_rank_band": 0.20,
  "foreground_min_fraction": 0.02,
  "foreground_max_fraction": 0.90,
  "foreground_center_width": 0.80,
  "preprocessing": ["raw", "clahe", "clahe_depth"],
  "representations": ["raw_all", "without_query", "pair_only", "query_relative", "relative_season"],
  "selection_eligible": ["without_query", "pair_only", "query_relative", "relative_season"],
  "pilot_svr": {"C": 1.0, "gamma": "scale", "epsilon": 0.2},
  "kernel": "rbf",
  "C": [0.1, 1.0, 10.0],
  "gamma": ["scale", 0.01, 0.1],
  "epsilon": [0.01, 0.1, 0.2, 0.3],
  "tol": 0.001,
  "cache_size_mb": 256,
  "max_iter": -1,
  "timing_repeats": 5,
  "score_tie_atol": 1e-12,
  "score_tie_rtol": 1e-10,
  "selection_order": ["highest_validation_mrr", "highest_validation_top1", "highest_validation_top5", "lowest_median_query_ms", "lowest_trial_id"]
}
